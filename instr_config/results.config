stego_score = stego-container:/home/ubuntu/.local/result/stego.grade : PARAM : STEGO_SCORE
integrity_score = stego-container:/home/ubuntu/.local/result/stego.grade : PARAM : INTEGRITY_SCORE
total_score = stego-container:/home/ubuntu/.local/result/stego.grade : PARAM : TOTAL_SCORE
